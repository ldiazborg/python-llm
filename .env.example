# Copy to .env and change the secrets. .env is git-ignored: never commit it.

# --- PostgreSQL (docker compose + ETL) ---
PG_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orders
POSTGRES_USER=orders_admin
POSTGRES_PASSWORD=change-me
# Read-only role used by the API (created by docker/postgres/init/01-roles.sh)
READER_USER=orders_reader
READER_PASSWORD=change-me-too

# --- vLLM (docker compose) ---
VLLM_IMAGE_TAG=v0.10.2
VLLM_PORT=8001
LLM_MODEL_ID=Qwen/Qwen2.5-Coder-1.5B-Instruct
# Fraction of total VRAM vLLM may claim. 4 GB GPU + fp16 1.5B (~3.1 GB weights) is tight:
# lower if vLLM reports not enough free memory, raise if it reports no room for KV cache.
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_MODEL_LEN=2048
# Only needed for gated models
HF_TOKEN=

# --- API -> LLM (OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:8001/v1
# Name vLLM serves the model under (--served-model-name)
LLM_MODEL=qwen-coder
# Shared secret between vLLM (--api-key) and the API
LLM_API_KEY=change-me-local-key
LLM_TIMEOUT_S=30

# --- Query guardrails ---
QUERY_ROW_LIMIT=1000
