# Copy to .env and change the secrets. .env is git-ignored: never commit it.

# --- PostgreSQL (docker compose + ETL) ---
PG_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orders
POSTGRES_USER=orders_admin
POSTGRES_PASSWORD=change-me
# Read-only role used by the API (created by docker/postgres/init/01-roles.sh)
READER_USER=orders_reader
READER_PASSWORD=change-me-too

# --- vLLM (docker compose) ---
VLLM_IMAGE_TAG=v0.10.2
VLLM_PORT=8001
LLM_MODEL_ID=Qwen/Qwen2.5-Coder-1.5B-Instruct
# Fraction of TOTAL VRAM vLLM may claim; must be <= free/total at startup.
# Measured on a 4 GB RTX 3050 under Docker Desktop/WSL2: only 3.21 GiB is ever
# free in the container (~0.8 GiB taken by WSL/CUDA), so 0.80 is the maximum.
# 0.80 = 2.89 GiB weights + 0.13 GiB activations + 0.16 GiB KV cache (~6k tokens).
# "Free memory on device ... is less than desired" -> lower it (or close GPU apps);
# "No available memory for the cache blocks"     -> raise it or lower VLLM_MAX_MODEL_LEN.
VLLM_GPU_MEM_UTIL=0.80
VLLM_MAX_MODEL_LEN=2048
# Only needed for gated models
HF_TOKEN=

# --- API -> LLM (OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:8001/v1
# Name vLLM serves the model under (--served-model-name)
LLM_MODEL=qwen-coder
# Shared secret between vLLM (--api-key) and the API
LLM_API_KEY=change-me-local-key
LLM_TIMEOUT_S=30

# --- Query guardrails ---
QUERY_ROW_LIMIT=1000

# --- Natural-language answers ---
# Result rows sent to the LLM to phrase the answer (prompt must fit VLLM_MAX_MODEL_LEN)
ANSWER_MAX_ROWS=20
